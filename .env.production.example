# ============================================================================
#  PRODUCTION env — dibaca docker-compose.prod.yml
#    cp .env.production.example .env.production      (JANGAN di-commit; sudah di .gitignore)
#    docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#  Dev memakai apps/api/.env & apps/web/.env (lihat .env.example di tiap app) — file ini TIDAK dipakai dev.
#  Staging: salin .env.staging.example (penjelasan tiap variabel ada di file ini).
#  Variabel bertanda [WAJIB] kosong → `docker compose` berhenti dengan pesan jelas.
# ============================================================================

# --- Stack ---
COMPOSE_PROJECT_NAME=ecommerce-prod
APP_ENV=production
# Image tag. Ganti per rilis supaya rollback = jalankan tag lama.
IMAGE_TAG=latest
# 127.0.0.1 = hanya reverse proxy di host yang bisa mengakses (disarankan). 0.0.0.0 = terbuka ke publik.
BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=3000
API_HOST_PORT=4000

# --- URL publik ---
# Web & API HARUS satu registrable domain (mis. tokoku.com & api.tokoku.com) agar cookie session
# (SameSite=Lax, Secure) terkirim. Wajib https di production.
# [WAJIB] URL web (jadi origin CORS & trusted origin auth)
WEB_URL=https://tokoku.com
# [WAJIB] URL API — ter-inline ke bundle browser saat build; mengganti = rebuild web (`up -d --build`).
NEXT_PUBLIC_API_URL=https://api.tokoku.com
# Default = NEXT_PUBLIC_API_URL. Isi hanya bila berbeda. API_PUBLIC_URL = tujuan webhook Midtrans/Biteship.
BETTER_AUTH_URL=
API_PUBLIC_URL=
# Hostname tambahan untuk next/image (custom domain R2/CDN), pisah koma. Ter-inline saat build web.
NEXT_IMAGE_HOSTS=

# --- Postgres (tidak dipublish ke host) ---
POSTGRES_USER=ecommerce
POSTGRES_DB=ecommerce
# [WAJIB] Harus URL-safe karena dirangkai ke DATABASE_URL: openssl rand -hex 24
# Mengubahnya setelah volume pertama dibuat TIDAK mengubah password lama (ubah lewat psql).
POSTGRES_PASSWORD=

# --- Auth ---
# [WAJIB] openssl rand -base64 32 (min 32 karakter, jangan mengandung "change_me")
BETTER_AUTH_SECRET=
# Opsional — isi keduanya atau kosongkan keduanya
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 [WAJIB] ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Midtrans [WAJIB] — production: key live + MIDTRANS_SANDBOX=false ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SANDBOX=false

# --- Biteship — WAJIB di production: key live (bukan biteship_test.*) + secret min 16 karakter ---
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_SECRET=

# --- Pusher — WAJIB di production: isi keempatnya ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

# --- Reverse proxy ---
# IP/CIDR proxy yang dipercaya untuk X-Forwarded-For (rate limit per IP). Reverse proxy di host mengakses
# container lewat gateway bridge Docker: cek dengan `docker network inspect <project>_default` (Gateway).
# Contoh: 172.18.0.1. Kosong = IP client yang terlihat selalu IP proxy.
TRUSTED_PROXIES=
