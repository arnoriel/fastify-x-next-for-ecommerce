{
  "name": "@ecommerce/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx src/db/reset.ts && npm run db:migrate && npm run db:seed",
    "infra:up": "docker compose up -d --wait",
    "infra:search": "docker compose --profile search up -d --wait",
    "infra:down": "docker compose --profile \"*\" down",
    "infra:reset": "docker compose --profile \"*\" down -v && docker compose up -d --wait",
    "infra:ps": "docker compose --profile \"*\" ps",
    "infra:logs": "docker compose --profile \"*\" logs -f --tail=100"
  },
  "dependencies": {
    "@ecommerce/shared": "*",
    "@fastify/cors": "^11.3.0",
    "better-auth": "^1.7.5",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.14"
  }
}
