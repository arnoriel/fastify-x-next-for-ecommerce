# --- API runtime ---
API_HOST=localhost
API_PORT=4000
WEB_URL=http://localhost:3000

# --- Docker infra (dibaca docker-compose.yml di folder ini) ---
# Port sengaja digeser supaya tidak bentrok dengan container lain
# (5432/5433 = postgres, 6379/6380 = redis, 3001 & 8001 = app lain)
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PORT=5434
REDIS_PORT=6381
MEILI_PORT=7700
MEILI_MASTER_KEY=ecommerce_dev_master_key_change_me

# --- Connection strings (harus sinkron dengan nilai di atas) ---
DATABASE_URL=postgresql://ecommerce:ecommerce@127.0.0.1:5434/ecommerce
REDIS_URL=redis://127.0.0.1:6381

# --- Auth (Better Auth) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev_only_secret_change_me_please_0123456789
BETTER_AUTH_URL=http://localhost:4000
# Opsional — Google OAuth (kosongkan keduanya untuk menonaktifkan)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 (S3-compatible) — upload gambar produk (T-04) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ecommerce-dev
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Midtrans (T-07) — ambil dari dashboard.sandbox.midtrans.com > Settings > Access Keys ---
# Sandbox keys (prefix: Mid-server-xxx / Mid-client-xxx)
MIDTRANS_SERVER_KEY=REDACTED
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_SANDBOX=true
# URL publik API yang bisa dijangkau Midtrans untuk webhook POST /webhook/midtrans.
# Dev: pakai ngrok/cloudflared tunnel → ngrok http 4000, lalu isi dengan URL tunnel.
# Production: isi dengan domain API production kamu (tanpa trailing slash).
# Kosongkan untuk nonaktifkan webhook otomatis (manual check tetap bisa via /api/checkout/:id/status).
API_PUBLIC_URL=

# --- Reverse proxy (production) ---
# IP/CIDR proxy yang boleh dipercaya untuk header X-Forwarded-For (pisah koma).
# Biarkan kosong di dev. Isi dengan IP/subnet Nginx/Caddy/Cloudflare-mu saat deploy,
# BUKAN range luas yang juga mencakup client.
TRUSTED_PROXIES=
