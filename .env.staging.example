# ============================================================================
#  STAGING env — stack identik production, tapi key SANDBOX + port/volume terpisah.
#    cp .env.staging.example .env.staging
#    docker compose --env-file .env.staging -f docker-compose.prod.yml up -d --build
#  Penjelasan tiap variabel: lihat .env.production.example.
#  APP_ENV=staging → API menerima Midtrans sandbox & Biteship biteship_test.* (production menolaknya).
#  Gunakan secret/DB BERBEDA dari production, jangan pernah menunjuk ke data production.
# ============================================================================
COMPOSE_PROJECT_NAME=ecommerce-staging
APP_ENV=staging
IMAGE_TAG=staging
BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=3100
API_HOST_PORT=4100

WEB_URL=https://staging.tokoku.com
NEXT_PUBLIC_API_URL=https://api-staging.tokoku.com
BETTER_AUTH_URL=
API_PUBLIC_URL=
NEXT_IMAGE_HOSTS=

POSTGRES_USER=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ecommerce-staging
R2_PUBLIC_URL=

# Sandbox (dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SANDBOX=true

# Testing mode Biteship (biteship_test.*)
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_SECRET=

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

TRUSTED_PROXIES=
